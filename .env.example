BOT_TOKEN=your_telegram_bot_token
DATABASE_URL=postgresql+asyncpg://luma:luma@localhost:5432/luma
REDIS_URL=redis://localhost:6379/0
WEBAPP_URL=http://localhost:5173
ADMIN_IDS=123456789
BOT_USERNAME=luma_bot
OPENAI_API_KEY=
SENTRY_DSN=
RULES_LINK_1=https://example.com/rules
RULES_LINK_2=https://example.com/privacy
WEBHOOK_URL=
WEBHOOK_SECRET=

# Платежи: yookassa (по умолчанию) | stars
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SHOP_SECRET_ID=
YOOKASSA_RETURN_URL=https://t.me/luma_bot
SPARK_PRICE_RUB=1.0
SPARK_PRICE_STARS=1.0

# Fragment — автовыплата Stars при выводе Искр
FRAGMENT_TON_SEED=
FRAGMENT_TONAPI_KEY=
FRAGMENT_WALLET_VERSION=V5R1
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_DT=-180
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_TON_TOKEN=
FRAGMENT_SHOW_SENDER=false
FRAGMENT_MIN_STARS=50

# Геопоиск (Yandex Geocoder) — обязателен для продакшена
YANDEX_GEOCODER_API_KEY=
GEO_NEARBY_RADIUS_KM=300
GEO_SAME_CITY_KM=25
GEO_HTTP_TIMEOUT_SEC=3
GEO_CACHE_TTL_FWD_SEC=7776000
GEO_CACHE_TTL_REV_SEC=2592000

# Локальный запуск (macOS + Homebrew):
#   brew services start postgresql@16
#   brew services start redis
#   cp .env.example .env   # и заполните BOT_TOKEN
#   ./scripts/setup_local.sh
#   .venv/bin/python main.py
#
# Геопоиск:
#   alembic upgrade head
#   .venv/bin/python scripts/backfill_geo.py
#   # затем в админке: geo_search_enabled = 1
#
# Альтернатива через Docker:
#   docker compose up -d
#   .venv/bin/python scripts/init_db.py
